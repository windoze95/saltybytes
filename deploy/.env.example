# /opt/saltybytes/.env — production environment for the droplet stack.
# chmod 600, owned by the deploy user. Compose reads it for variable
# substitution AND passes it to the api container (env_file).
#
# Values marked (SSM) were previously stored in AWS SSM Parameter Store under
# /saltybytes/prod/<NAME>; copy them across with:
#   aws ssm get-parameters-by-path --path /saltybytes/prod --with-decryption \
#     --query 'Parameters[].[Name,Value]' --output text

# ---- stack (compose substitution) ----------------------------------------
API_IMAGE_TAG=latest              # pinned by scripts/deploy.sh on each deploy
POSTGRES_USER=saltybytes
POSTGRES_PASSWORD=                # long random; also inside DATABASE_URL below
POSTGRES_DB=saltybytes
DB_BIND_IP=127.0.0.1              # set to this host's Tailscale IP (tailscale ip -4) so the dashboard can reach Postgres over the tailnet
BACKUP_REMOTE=r2:saltybytes-backups/pg
BACKUP_RETAIN=30d

# ---- api: core -------------------------------------------------------------
DATABASE_URL=postgres://saltybytes:<POSTGRES_PASSWORD>@db:5432/saltybytes?sslmode=disable
JWT_SECRET_KEY=                   # (SSM)
ID_HEADER=                        # (SSM)
ADMIN_TOKEN=                      # (SSM)
PUBLIC_BASE_URL=https://api.saltybytes.ai
SITE_BASE_URL=https://saltybytes.ai
SITE_IOS_APP_URL=
SITE_ANDROID_APP_URL=

# ---- images: Cloudflare R2 (S3-compatible) ---------------------------------
S3_BUCKET=saltybytes-images
S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=                 # R2 API token (Object Read & Write on saltybytes-images)
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://img.saltybytes.ai   # R2 custom domain; stored image URLs are built from this

# ---- email: Amazon SES (kept on AWS; the only AWS service still in use) ----
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=                # IAM user "saltybytes-ses": ses:SendEmail only
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=                       # (SSM)
EMAIL_VERIFICATION_ENABLED=true   # (SSM)

# ---- AI providers ----------------------------------------------------------
ANTHROPIC_API_KEY=                # (SSM)
OPENAI_API_KEY=                   # (SSM)
GEMINI_API_KEY=                   # (SSM)
VIDEO_NATIVE_GEMINI=true
VISION_NATIVE_GEMINI=true
AI_DAILY_BUDGET_USD=              # (SSM)

# ---- search / scraping -----------------------------------------------------
BRAVE_SEARCH_KEY=                 # (SSM)
GOOGLE_SEARCH_KEY=                # (SSM)
GOOGLE_SEARCH_CX=
FIRECRAWL_API_KEY=                # (SSM)
SCRAPECREATORS_API_KEY=           # (SSM)

# ---- alerts ----------------------------------------------------------------
NTFY_URL=                         # (SSM)
NTFY_TOPIC=                       # (SSM)
NTFY_TOKEN=

# ---- store billing ---------------------------------------------------------
PLAY_SERVICE_ACCOUNT_JSON=        # (SSM) raw JSON on one line
PLAY_PACKAGE_NAME=codes.julian.saltybytes
APPLE_BUNDLE_ID=codes.julian.saltybytes
RTDN_PUSH_SECRET=                 # (SSM)
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_B64=
