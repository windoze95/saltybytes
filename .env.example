# Database (PostgreSQL with pgvector extension)
DATABASE_URL=postgres://user:password@localhost:5432/saltybytes_db?sslmode=disable

# Server
PORT=8080
JWT_SECRET_KEY=             # Secret for signing/verifying auth JWTs (required)
# Shared secret that gates the API to the official client. The app sends it as
# the X-SaltyBytes-Identifier header (built in via the SALTYBYTES_ID define);
# requests without a matching value are rejected. Required — set to a long random string.
ID_HEADER=

# Set to "true" ONLY for local development to allow http://localhost browser
# origins on the cooking WebSocket. Leave unset/false in production.
ALLOW_DEV_ORIGINS=

# AWS (S3 image storage)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=saltybytesrecipeimages

# AI Providers
ANTHROPIC_API_KEY=          # Claude - text/reasoning
OPENAI_API_KEY=             # Whisper, DALL-E, embeddings

# Web Search (Brave primary + Google fallback, both optional)
BRAVE_SEARCH_KEY=           # Brave Search API key
GOOGLE_SEARCH_KEY=          # Google Custom Search API key
GOOGLE_SEARCH_CX=           # Google Custom Search engine ID

# Scraping fallback (optional — used when sites block direct HTTP fetch)
FIRECRAWL_API_KEY=          # Firecrawl API key for Cloudflare-blocked sites

# Public website (saltybytes.ai — served by this same binary)
SITE_BASE_URL=https://saltybytes.ai   # canonical/OG/sitemap base for public pages
SITE_IOS_APP_URL=                     # App Store link; store badges show "soon" while empty
SITE_ANDROID_APP_URL=                 # Play Store link; store badges show "soon" while empty

# Store billing (IAP)
PLAY_SERVICE_ACCOUNT_JSON=  # Google Play service-account key JSON (raw); google verification off while empty
PLAY_PACKAGE_NAME=codes.julian.saltybytes
APPLE_BUNDLE_ID=codes.julian.saltybytes
RTDN_PUSH_SECRET=           # shared secret for the Google Pub/Sub push endpoint (?token=...)
APPLE_IAP_KEY_ID=           # optional App Store Server API key (In-App Purchase role) for re-polling
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_B64=
